{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimum core capability for the local MeetingLens window",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "core:default",
    "document-management-commands",
    "meeting-data-commands",
    "sidecar-status-command",
    "secret-status-management",
    "summary-run-commands",
    "transcript-management-commands"
  ]
}
