{
  "name": "meetinglens",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit --pretty false -p tsconfig.json && tsc --noEmit --pretty false -p tsconfig.node.json",
    "lint": "eslint . && python -m ruff check sidecar",
    "format": "prettier --write . && python -m ruff format sidecar",
    "format:check": "prettier --check . && python -m ruff format --check sidecar",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sidecar": "python -m unittest discover -s sidecar/tests -v",
    "check:sidecar": "python -m compileall -q sidecar && npm run test:sidecar",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run check:sidecar && npm run build",
    "sidecar": "python -m sidecar.meetinglens_sidecar.server",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.8.0",
    "jsdom": "29.1.1",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
